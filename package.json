{
  "name": "job-checker",
  "version": "6.1.0",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "description": "Decides which CI jobs a pull request needs from its changed files and commit tags",
  "type": "module",
  "keywords": [
    "actions",
    "ci",
    "changes"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotki/action-job-checker.git"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "rollup -c rollup.config.mjs",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "pnpm run build && pnpm run lint && pnpm run package && pnpm test",
    "prepare": "husky",
    "release": "bumpp --no-push"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@rotki/eslint-config": "5.0.1",
    "@rotki/eslint-plugin": "1.3.2",
    "@types/node": "24.19.2",
    "bumpp": "12.3.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "js-yaml": "5.4.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "rollup": "4.64.7",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "lint-staged": {
    "*.{js,ts,vue,md,json,yml}": "eslint"
  }
}
