{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":dependencyDashboardApproval",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "allowedVersions": "/^(24)\\./",
      "groupName": "Node.js",
      "matchPackageNames": ["@types/node", "node"]
    },
    {
      "allowedVersions": "/^(12)\\./",
      "matchPackageNames": ["pnpm"]
    },
    {
      "description": "typescript-eslint and @rollup/plugin-typescript need the TS 6 JS API",
      "allowedVersions": "<7",
      "matchPackageNames": ["typescript"]
    },
    {
      "description": "First-party packages, no cooldown needed",
      "matchPackageNames": ["@rotki/eslint-config", "@rotki/eslint-plugin"],
      "minimumReleaseAge": "0 days"
    }
  ]
}
